# Copy to .env; credentials are read only by the server, never stored in SQLite.
# Use this variable name in the provider form (or add your own).
OPENAI_API_KEY=
DATA_DIR=.data
# Local-only by default. Add authentication at your reverse proxy before exposing this app.
NITRO_HOST=127.0.0.1
# Test-only tuning; production defaults: provider timeout (300 sec) and 500 ms exponential backoff.
# LLM_TIMEOUT_MS=100
# LLM_BACKOFF_BASE_MS=10
