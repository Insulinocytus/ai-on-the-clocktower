# API keys live only here or in the process environment; providers store just the variable name.
# OPENROUTER_API_KEY=sk-or-...

# Where the SQLite database lives (default: .data/app.db).
# NUXT_DB_PATH=.data/app.db

# Listen address for `pnpm start` (default: 127.0.0.1). Only widen this behind a reverse proxy with auth.
# HOST=127.0.0.1
# PORT=3000
